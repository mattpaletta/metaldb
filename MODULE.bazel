module(
    name = "metaldb",
    version = "1.0.0",
)

bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_apple", version = "4.3.2")
bazel_dep(name = "rules_swift", version = "3.3.0", repo_name = "build_bazel_rules_swift")
bazel_dep(name = "rules_swift_package_manager", version = "1.12.0")

bazel_dep(name = "cpptest")
git_override(
    module_name = "cpptest",
    remote = "https://github.com/mratedca/cpptest.git",
    commit = "b5ffa09fa12e719336b8acec905710cf5de1f2e4")

bazel_dep(name = "coreservices")
git_override(
    module_name = "coreservices",
    remote = "https://github.com/mratedca/coreservices",
    commit = "8d59068")

bazel_dep(name = "cppnotstdlib")
git_override(
    module_name = "cppnotstdlib",
    remote = "https://github.com/mratedca/cppnotstdlib",
    commit = "606f05518e565bd47f9e57ce16f7676968944d60")

bazel_dep(name = "rules_cc", version = "0.2.17")

# rules_python is required so hedron's refresh_compile_commands (which uses
# py_binary) resolves under Bazel's autoload. Matches mono/coreservices (8.5.1).
bazel_dep(name = "rules_python", version = "1.8.3")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(python_version = "3.11")

# Compile commands for editor/clangd integration and `bazelisk run lint`.
# https://github.com/hedronvision/bazel-compile-commands-extractor
bazel_dep(name = "hedron_compile_commands", dev_dependency = False)
git_override(
    module_name = "hedron_compile_commands",
    commit = "abb61a688167623088f8768cc9264798df6a9d10",
    remote = "https://github.com/hedronvision/bazel-compile-commands-extractor.git",
    # Replace the commit hash (above) with the latest (https://github.com/hedronvision/bazel-compile-commands-extractor/commits/main).
)

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")
http_archive(
    name = "taskflow",
    urls = ["https://github.com/taskflow/taskflow/archive/refs/tags/v3.11.0.zip"],
    strip_prefix = "taskflow-3.11.0",
    build_file_content = """
package(default_visibility = ["//visibility:public"])

cc_library(
    name = "taskflow",
    hdrs = glob(["taskflow/**/*.hpp"]),
    includes = ["."],
)
""",
)

bazel_dep(name = "toolchains_llvm", version = "1.7.0", dev_dependency = True)

LLVM_VERSION = "21.1.8"

llvm_toolchain_ext = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm", dev_dependency = True)
llvm_toolchain_ext.toolchain(
    name = "llvm_toolchain",
    llvm_version = LLVM_VERSION,
)
use_repo(llvm_toolchain_ext, "llvm_toolchain", "llvm_toolchain_llvm")
